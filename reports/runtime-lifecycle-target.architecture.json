  "cards": [
    {
      "dot": "cyan",
      "title": "Critical Boundary",
      "items": [
        "Only RuntimeTransitionController may change lifecycle phase",
        "The previous Active Runtime stays visible until candidate commit",
        "UI readiness is published after Runtime and registry agree"
      ]
    },
    {
      "dot": "emerald",
      "title": "Save Contract",
      "items": [
        "Workspace revision advances once",
        "Runtime identity advances at the same commit boundary",
        "Every outcome restores controls through one finally path"
      ]
    },
    {
      "dot": "amber",
      "title": "Failure Isolation",
      "items": [
        "Context, diagnostics and telemetry run after commit",
        "Auxiliary timeout never tears down a healthy Runtime",
        "Every transition carries an epoch for stale-event rejection"
      ]
    }
